# =========================================================================
# Root Environment Variables Template for Docker Compose
# Copy this file to '.env' in the root directory and update the values.
# =========================================================================

# Database configuration for local Postgres service
POSTGRES_DB=face_attendance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Backend service configuration
# Use 'db' as the hostname inside Docker network
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/face_attendance
SECRET_KEY=generate_a_secure_random_key_here
JWT_SECRET_KEY=generate_another_secure_random_key_here

# Frontend service configuration
# Points to the backend container inside Docker (or localhost for local browser requests)
VITE_API_BASE_URL=http://localhost:5000/api
